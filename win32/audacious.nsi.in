; audacious.nsi - Audacious Windows NSIS installer
;
; Build: makensis -V3 build\win32\audacious.nsi

!include "MUI2.nsh"
!include "LogicLib.nsh"

!define VERSION        "@PACKAGE_VERSION@"
!define INSTALL_PREFIX "@INSTALL_PREFIX@"
!define NSIS_SRCDIR    "@NSIS_SRCDIR@"
!define UNINST_KEY     "Software\Microsoft\Windows\CurrentVersion\Uninstall\Audacious"
!define INSTALLER_ICON "${NSIS_SRCDIR}\images\audacious.ico"

Name "Audacious ${VERSION}"
OutFile "audacious-${VERSION}-win32.exe"

RequestExecutionLevel admin
SetCompressor /SOLID lzma
InstallDir "$PROGRAMFILES\Audacious"

!define MUI_ICON                 "${INSTALLER_ICON}"
!define MUI_UNICON               "${INSTALLER_ICON}"
!define MUI_WELCOMEPAGE_TITLE    "Audacious ${VERSION} Setup"
!define MUI_WELCOMEPAGE_TEXT     "Setup will install Audacious ${VERSION}. The installer auto-detects previous Audacious installations and upgrades them in place. Click Next to continue."
!define MUI_DIRECTORYPAGE_TEXT_TOP "Setup will install Audacious into the folder below. Previous installs are auto-detected and pre-filled. Click Install to begin."

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

; ============================================================
; .onInit - detect old install from registry
; ============================================================
Function .onInit
  ReadRegStr $INSTDIR HKLM "${UNINST_KEY}" "InstallLocation"
  ${If} $INSTDIR == ""
    ReadRegStr $INSTDIR HKCU "${UNINST_KEY}" "InstallLocation"
  ${EndIf}

  ${If} $INSTDIR != ""
    MessageBox MB_ICONINFORMATION|MB_YESNO|MB_DEFBUTTON1 "Found prior Audacious install. Upgrade in place?" /SD IDYES IDYES UseRegistryPath IDNO ClearPath
    UseRegistryPath:
      Goto InitDone
    ClearPath:
      StrCpy $INSTDIR ""
    InitDone:
  ${Else}
    IfFileExists "$PROGRAMFILES\Audacious\bin\audacious.exe" 0 NoDefaultInstall
      MessageBox MB_ICONEXCLAMATION|MB_YESNO "Audacious already exists in default folder. Overwrite?" /SD IDYES IDYES UseDefaultFolder IDNO NoDefaultInstall
      UseDefaultFolder:
        StrCpy $INSTDIR "$PROGRAMFILES\Audacious"
    NoDefaultInstall:
  ${EndIf}
FunctionEnd

; ============================================================
; Install section
; ============================================================
Section "Audacious" InstallSection
  SectionIn RO

  ; Clean old installation (overwrite)
  SetOutPath "$INSTDIR"
  RMDir /r "$INSTDIR\bin"
  RMDir /r "$INSTDIR\etc"
  RMDir /r "$INSTDIR\lib"
  RMDir /r "$INSTDIR\share"

  ; Copy new files
  SetOutPath "$INSTDIR\bin"
  File /r "${INSTALL_PREFIX}\bin\*.*"

  SetOutPath "$INSTDIR\lib"
  File /r "${INSTALL_PREFIX}\lib\*.*"

  SetOutPath "$INSTDIR\share"
  File /r "${INSTALL_PREFIX}\share\*.*"

  ; Write registry entries (critical: InstallLocation lets NEXT upgrade find us)
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayName"     "Audacious"
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayVersion"  "${VERSION}"
  WriteRegStr HKLM "${UNINST_KEY}" "Publisher"       "Audacious developers"
  WriteRegStr HKLM "${UNINST_KEY}" "InstallLocation"  "$INSTDIR"
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayIcon"     "$INSTDIR\uninstall.exe"
  WriteRegStr HKLM "${UNINST_KEY}" "UninstallString"  "$INSTDIR\uninstall.exe"
  WriteRegDWORD HKLM "${UNINST_KEY}" "NoModify"  1
  WriteRegDWORD HKLM "${UNINST_KEY}" "NoRepair"  1

  WriteUninstaller "$INSTDIR\uninstall.exe"
SectionEnd

Section "Start Menu Shortcut" StartMenuSection
  SetShellVarContext all
  CreateShortCut "$SMPROGRAMS\Audacious.lnk" "$INSTDIR\bin\audacious.exe"
SectionEnd

Section "Desktop Shortcut" DesktopSection
  SetShellVarContext all
  CreateShortCut "$DESKTOP\Audacious.lnk" "$INSTDIR\bin\audacious.exe"
SectionEnd

Section "Uninstall" UninstallSection
  RMDir /r "$INSTDIR"
  SetShellVarContext all
  Delete "$SMPROGRAMS\Audacious.lnk"
  Delete "$DESKTOP\Audacious.lnk"
  DeleteRegKey HKLM "${UNINST_KEY}"
  DeleteRegKey HKCU "${UNINST_KEY}"
SectionEnd
